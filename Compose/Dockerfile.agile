# Parte de la imagen original de Agile Data Science (2021-10-26)
# Usando digest para garantizar reproducibilidad y evitar cambios inesperados
FROM rjurney/agile_data_science@sha256:d7b4e9787fe4d44046a4d6d39116546e3911cf93251a864ce5d221f76ec78042

USER root

# 1) Java 17 (requerido por Spark 3.5.x)
RUN rm -f /etc/apt/sources.list.d/mongodb-org*.list && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openjdk-17-jdk curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:${PATH}"

# 2) Spark 3.5.6 (Hadoop 3) y symlink /usr/local/spark
ARG SPARK_VER=3.5.6
ARG HADOOP_PROFILE=hadoop3
RUN mkdir -p /usr/local && \
    curl -fsSL "https://archive.apache.org/dist/spark/spark-${SPARK_VER}/spark-${SPARK_VER}-bin-${HADOOP_PROFILE}.tgz" \
    | tar -xz -C /usr/local && \
    ln -sfn "/usr/local/spark-${SPARK_VER}-bin-${HADOOP_PROFILE}" /usr/local/spark

ENV SPARK_HOME=/usr/local/spark
ENV PATH="$SPARK_HOME/bin:$PATH"

# 3) Dependencias de Python (coinciden con las de compose)
# Usar el pip del entorno Conda base para instalar dependencias en /opt/conda
RUN /opt/conda/bin/pip install --no-cache-dir \
      pyspark==3.5.6 \
      kafka-python \
      pymongo \
      papermill \
      flask \
      kagglehub

# Versiones compatibles de NumPy y SciPy para el kernel de entrenamiento
RUN /opt/conda/bin/pip install --no-cache-dir \
      "numpy==1.26.4" \
      "scipy==1.11.4" \
      "seaborn==0.12.2"

# NumPy intenta ejecutar `lscpu` al importar numpy.testing para detectar SVE.
# Bajo Rosetta (imagen amd64 sobre host arm64), el subproceso puede bloquear
# kernels multihilo de Jupyter/Papermill. SVE no aplica al contenedor x86_64.
RUN sed -i \
      's/_SUPPORTS_SVE = check_support_sve()/_SUPPORTS_SVE = False/' \
      /opt/conda/lib/python3.9/site-packages/numpy/testing/_private/utils.py
